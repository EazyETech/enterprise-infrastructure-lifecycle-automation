# Planning scaffold for a vSphere lab. Rename to versions.tf after you have
# reviewed it and created variables.tf, main.tf, and outputs.tf.
#
# Credentials must never be written in this file. Supply them through
# environment variables (TF_VAR_vsphere_password) or a gitignored terraform.tfvars.

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    vsphere = {
      source  = "hashicorp/vsphere"
      version = "~> 2.8"
    }
  }
}

provider "vsphere" {
  vsphere_server       = var.vsphere_server
  user                 = var.vsphere_user
  password             = var.vsphere_password
  allow_unverified_ssl = true # lab only
}
